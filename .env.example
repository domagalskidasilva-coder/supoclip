# SupoClip local environment
# Copy this file to .env and fill the provider keys you want to use.

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3107
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3107,http://sp.localhost:3107,http://supoclip.localhost:3107

# Database and Redis
DATABASE_URL=postgresql+asyncpg://supoclip:supoclip_password@127.0.0.1:5432/supoclip
FRONTEND_DATABASE_URL=postgresql://supoclip:supoclip_password@127.0.0.1:5432/supoclip
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
TEMP_DIR=backend/.tmp

# Runtime settings are encrypted before storage in app_settings.
APP_SETTINGS_ENCRYPTION_KEY=supoclip_local_settings_secret_change_me

# Required for transcription
ASSEMBLY_AI_API_KEY=
ASSEMBLY_AI_HTTP_TIMEOUT_SECONDS=900

# Choose one transcript-analysis model.
# Hosted providers require the matching API key below.
LLM=google-gla:gemini-3-flash-preview
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Ollama can run locally without an API key.
# Example: LLM=ollama:gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Optional B-roll provider
PEXELS_API_KEY=

# YouTube download and metadata providers
YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp
YOUTUBE_METADATA_PROVIDER=yt_dlp
YOUTUBE_DATA_API_KEY=
APIFY_API_TOKEN=
APIFY_YOUTUBE_DEFAULT_QUALITY=1080
APIFY_RUN_TIMEOUT_SECONDS=900

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=universal-3-pro,universal-2
QUEUED_TASK_TIMEOUT_SECONDS=180
WHISPER_MODEL_SIZE=medium

# Optional analytics and feedback
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=
